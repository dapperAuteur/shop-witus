# Copy to .env.local and fill from the operator tasks in plans/user-tasks/.
# NEVER commit .env.local. Claude does not read .env* files.

# === Database: Neon Postgres (operator task 01) ===
# Also read as fallbacks: STORAGE_DATABASE_URL / STORAGE_POSTGRES_URL — Vercel's
# Neon integration injects the connection string with a STORAGE_ prefix.
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# === App ===
APP_URL="http://localhost:3030"

# === Auth: better-auth (operator task 05) ===
# Generate a long random string, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3030"

# === "Sign in with WitUS" ecosystem OIDC (optional; everything stays off until set) ===
# Provisioned against the accounts.witus.online IdP. Redirect URI the IdP must allow:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/witus
# CLIENT_ID gates THREE things at once: the OIDC provider + button, the silent
# "Continue as <name>" check on /sign-in, and global sign-out ("Sign out of WitUS").
# With it unset there are no requests to the IdP at all. See plans/user-tasks/13-*.
WITUS_OIDC_CLIENT_ID=""
WITUS_OIDC_CLIENT_SECRET=""
# Optional override; defaults to https://accounts.witus.online/api/idp/.well-known/openid-configuration
# The endsession + "Continue as" endpoints are DERIVED from this, so it is the only IdP
# URL configured anywhere in the app (src/lib/silent-sso.ts).
WITUS_OIDC_DISCOVERY_URL=""

# === Email: Mailgun magic-link (operator tasks 04, 05) ===
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mg.witus.online"
MAIL_FROM="Shop.WitUS <no-reply@mg.witus.online>"

# === Cloudinary: product images (operator tasks 03, 05) ===
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# === Store-connector token encryption (operator task 05) ===
# 32-byte key (base64/hex) used to encrypt OAuth tokens at rest in store_connections.
STORE_TOKEN_ENC_KEY=""

# === Wix connector OAuth (operator task 07) ===
WIX_CLIENT_ID=""
WIX_CLIENT_SECRET=""
WIX_REDIRECT_URI="http://localhost:3030/api/connect/wix/callback"

# === WitUS ecosystem (all optional; features no-op until set) ===
# Inbox (signed-webhook triage). source slug must match an INGEST_SOURCES entry.
INBOX_INGEST_URL=""
INBOX_SOURCE_SLUG="shop-witus"
INBOX_INGEST_SECRET=""
# Outbox (social-post drafts). Needs a shop-witus caption recipe before wiring.
OUTBOX_INGEST_URL=""
OUTBOX_SOURCE_SLUG="shop-witus"
OUTBOX_INGEST_SECRET=""
# PostHog (privacy-first; off by default even when set)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# === Error monitoring: Better Stack via the Sentry SDK (all optional) ===
# Leave every value empty and the SDK never initializes: no events, no network calls, no behavior
# change. Copy the DSN from the Better Stack source you create (it is Sentry-DSN compatible).
# Server + edge runtimes:
SENTRY_DSN=""
# Browser runtime (inlined at build time, so it is public by design):
NEXT_PUBLIC_SENTRY_DSN=""
# Labels events in the dashboard; falls back to VERCEL_ENV then NODE_ENV.
SENTRY_ENVIRONMENT=""
# Build-time source-map upload only (read in next.config.ts, never at runtime). Without an auth
# token the upload step is skipped and stack traces stay minified.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
